rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (uid)
    // Fields:
    //   - uid: string (required)
    //   - displayName: string (optional)
    //   - email: string (required)
    //   - photoURL: string (optional)
    //   - username: string (required)
    //   - bio: string (optional)
    //   - createdAt: timestamp (required)
    //
    // Collection: posts
    // Document ID: postId
    // Fields:
    //   - userId: string (required)
    //   - username: string (required)
    //   - userPhotoURL: string (optional)
    //   - imageUrl: string (required)
    //   - caption: string (optional)
    //   - likesCount: number (required)
    //   - commentsCount: number (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: stories
    // Document ID: storyId
    // Fields:
    //   - userId: string (required)
    //   - username: string (required)
    //   - userPhotoURL: string (optional)
    //   - imageUrl: string (required)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'username', 'createdAt']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             (data.get('bio', '') is string && data.get('bio', '').size() <= 150);
    }

    function isValidPost(data) {
      return data.keys().hasAll(['userId', 'username', 'imageUrl', 'likesCount', 'commentsCount', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.username is string &&
             data.imageUrl is string &&
             data.likesCount is number && data.likesCount >= 0 &&
             data.commentsCount is number && data.commentsCount >= 0;
    }

    function isValidStory(data) {
      return data.keys().hasAll(['userId', 'username', 'imageUrl', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.username is string &&
             data.imageUrl is string;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin' ||
          (request.auth.token.email == "hoangnnse183499@fpt.edu.vn" && request.auth.token.email_verified == true));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPost(request.resource.data);
      allow update: if isAuthenticated() && (
        (isDocOwner() && isValidPost(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
      );
      allow delete: if isDocOwner() || isAdmin();

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      }

      // Likes subcollection
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // Stories collection
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidStory(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }
  }
}
